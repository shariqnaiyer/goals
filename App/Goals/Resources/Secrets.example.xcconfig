// Copy this file to `Secrets.xcconfig` (same directory) and fill in your proxy
// URL to enable the live LLM coach. Without it, the app runs on the offline
// deterministic MockLLMService — fully usable, no backend required.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// Secrets.xcconfig is git-ignored. Never commit real endpoints/keys.

// Base URL of your deployed proxy (see /proxy). No trailing slash.
LLM_PROXY_BASE_URL = https:/$()/your-proxy.example.workers.dev

// Google Calendar integration (optional). Create an iOS OAuth client in Google
// Cloud Console (bundle id com.shariqnaiyer.goals, Calendar API enabled) and
// paste its client ID + the reversed form. Absent → integration shows as
// "setup required"; everything else in the app works without it.
GOOGLE_OAUTH_CLIENT_ID = 1234567890-abcdef.apps.googleusercontent.com
GOOGLE_OAUTH_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdef
